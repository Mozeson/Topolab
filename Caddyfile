# Static hosting for the built site (see Dockerfile). Railway sets PORT.
{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	# Built scripts and styles carry a content hash in their name: cache them for good.
	# (assets/field/ textures keep plain names, so they get normal revalidation.)
	@hashed path_regexp ^/assets/[^/]+\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# The page itself is always revalidated, so a new deploy shows up on the next load.
	@page path / /index.html
	header @page Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
